#!/usr/bin/env python3
"""Stable Kiseki DA launcher; generated by the transactional installer."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

home = Path(os.environ.get("KISEKI_DA_HOME", Path(__file__).resolve().parent.parent)).expanduser().resolve()
pointer = home / "current.json"
try:
    current = json.loads(pointer.read_text(encoding="utf-8"))
    runtime = Path(current["runtime"]).resolve()
except (OSError, ValueError, KeyError) as exc:
    sys.stderr.write(f"Kiseki DA runtimeを解決できません: {exc}\n")
    raise SystemExit(1)
if not runtime.is_dir():
    sys.stderr.write(f"Kiseki DA runtimeがありません: {runtime}\n")
    raise SystemExit(1)
os.environ["KISEKI_DA_HOME"] = str(home)
sys.path.insert(0, str(runtime))
from installer.cli import main

raise SystemExit(main())
